{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/backend/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' https:; frame-src https://accounts.google.com; upgrade-insecure-requests" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "rewrites": [
    {
    "source": "/backend/health/",
      "destination": "https://16-16-204-58.sslip.io/health/"
    },
    {
      "source": "/backend/:path*/",
      "destination": "https://16-16-204-58.sslip.io/:path*/"
    },
    {
      "source": "/backend/:path*",
      "destination": "https://16-16-204-58.sslip.io/:path*"
    },
    {
      "source": "/single/:slug/:id/p/:color/:storage",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|discordbot|pinterest|slackbot|skypeuripreview|googlebot|bingbot)"
        }
      ],
      "destination": "/api/product-share?slug=:slug&id=:id&color=:color&storage=:storage"
    },
    {
      "source": "/single/:slug/:id/p/storage/:storage",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|discordbot|pinterest|slackbot|skypeuripreview|googlebot|bingbot)"
        }
      ],
      "destination": "/api/product-share?slug=:slug&id=:id&storage=:storage"
    },
    {
      "source": "/single/:slug/:id/p/:color",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|discordbot|pinterest|slackbot|skypeuripreview|googlebot|bingbot)"
        }
      ],
      "destination": "/api/product-share?slug=:slug&id=:id&color=:color"
    },
    {
      "source": "/single/:slug/:id/p",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)(whatsapp|facebookexternalhit|facebot|twitterbot|telegrambot|linkedinbot|discordbot|pinterest|slackbot|skypeuripreview|googlebot|bingbot)"
        }
      ],
      "destination": "/api/product-share?slug=:slug&id=:id"
    },
    {
      "source": "/:path((?!backend(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}

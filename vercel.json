{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/backend/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://accounts.google.com; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://backend.eehook.com https://images.unsplash.com; media-src 'self' https://backend.eehook.com; connect-src 'self' https://backend.eehook.com https://accounts.google.com; frame-src https://accounts.google.com; upgrade-insecure-requests" },
        { "key": "Access-Control-Allow-Origin", "value": "https://staging.eehook.com" },
        { "key": "Vary", "value": "Origin" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "rewrites": [
    {
    "source": "/backend/health/",
      "destination": "https://backend.eehook.com/health/"
    },
    {
      "source": "/backend/:path*/",
      "destination": "https://backend.eehook.com/:path*/"
    },
    {
      "source": "/backend/:path*",
      "destination": "https://backend.eehook.com/:path*"
    },
    {
      "source": "/single/:slug/:id/p/:color/:storage",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": ".*(WhatsApp|whatsapp|FacebookExternalHit|facebookexternalhit|Facebot|facebot|Twitterbot|twitterbot|TelegramBot|telegrambot|LinkedInBot|linkedinbot|Discordbot|discordbot|Pinterest|pinterest|Slackbot|slackbot|SkypeUriPreview|skypeuripreview|Googlebot|googlebot|bingbot).*"
          }
        }
      ],
      "destination": "/api/product-share?slug=:slug&id=:id&color=:color&storage=:storage"
    },
    {
      "source": "/single/:slug/:id/p/storage/:storage",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": ".*(WhatsApp|whatsapp|FacebookExternalHit|facebookexternalhit|Facebot|facebot|Twitterbot|twitterbot|TelegramBot|telegrambot|LinkedInBot|linkedinbot|Discordbot|discordbot|Pinterest|pinterest|Slackbot|slackbot|SkypeUriPreview|skypeuripreview|Googlebot|googlebot|bingbot).*"
          }
        }
      ],
      "destination": "/api/product-share?slug=:slug&id=:id&storage=:storage"
    },
    {
      "source": "/single/:slug/:id/p/:color",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": ".*(WhatsApp|whatsapp|FacebookExternalHit|facebookexternalhit|Facebot|facebot|Twitterbot|twitterbot|TelegramBot|telegrambot|LinkedInBot|linkedinbot|Discordbot|discordbot|Pinterest|pinterest|Slackbot|slackbot|SkypeUriPreview|skypeuripreview|Googlebot|googlebot|bingbot).*"
          }
        }
      ],
      "destination": "/api/product-share?slug=:slug&id=:id&color=:color"
    },
    {
      "source": "/single/:slug/:id/p",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": ".*(WhatsApp|whatsapp|FacebookExternalHit|facebookexternalhit|Facebot|facebot|Twitterbot|twitterbot|TelegramBot|telegrambot|LinkedInBot|linkedinbot|Discordbot|discordbot|Pinterest|pinterest|Slackbot|slackbot|SkypeUriPreview|skypeuripreview|Googlebot|googlebot|bingbot).*"
          }
        }
      ],
      "destination": "/api/product-share?slug=:slug&id=:id"
    },
    {
      "source": "/:path((?!backend(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}

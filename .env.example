# Local development and Vercel production both use the same /backend API path.
# Vite proxies it locally; vercel.json rewrites it to Django after deployment.
VITE_API_BASE_URL=/backend
VITE_DEV_API_PROXY_TARGET=https://16.16.204.58

# Public OAuth client ID; use the same ID as backend GOOGLE_CLIENT_ID.
# Do not place OAuth client secrets in VITE_* variables.
VITE_GOOGLE_CLIENT_ID=

# Cashfree hosted checkout runs in the browser with a public mode only.
# The Cashfree client ID and secret must never be placed in VITE_* variables.
VITE_CASHFREE_MODE=sandbox

# Stripe Checkout is hosted by Stripe, so no Stripe secret belongs in VITE_*.
# The backend creates and verifies Stripe Checkout Sessions.

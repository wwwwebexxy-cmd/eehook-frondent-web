# Local development only: Vite proxies /backend to Django so cookie auth and
# CSRF work without weakening production CORS.
VITE_API_URL=/backend
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# Public OAuth client ID; do not place secrets in VITE_* variables.
VITE_GOOGLE_CLIENT_ID=

# Comma-separated checkout hosts. Defaults to checkout.stripe.com when unset.
VITE_CHECKOUT_ALLOWED_HOSTS=checkout.stripe.com
